# Copy this file to .env.compose and replace every placeholder with a long random value.
POSTGRES_PASSWORD=replace-with-strong-database-password
JWT_SIGNING_KEY=replace-with-a-random-signing-key-of-at-least-64-characters
REFRESH_TOKEN_PEPPER=replace-with-random-refresh-token-pepper
DEV_SEED_KEY=replace-with-a-different-random-owner-provisioning-key
